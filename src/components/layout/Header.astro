---
import { useTranslations } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import { ThemeToggle } from '@/components/layout/ThemeToggle';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = `/${lang}/`;
const docsHref = `/${lang}/docs/frontend-performance/critical-rendering-path-hydration/`;
const feedbackHref = `/${lang}/feedback/`;
---

<header class="sticky top-0 z-40 w-full border-b-2 border-ink bg-surface/95 backdrop-blur-xs">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-3 sm:px-6">
    <div class="flex items-center gap-6">
      <a
        href={homeHref}
        class="group inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
        aria-label="DevPlay"
      >
        <svg
          viewBox="0 0 148 38"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="h-9 w-auto transition-transform group-hover:scale-105"
          aria-hidden="true"
        >
          <g stroke="var(--ink)" stroke-width="2" stroke-linejoin="round">
            <polygon points="4,10 11,3 32,3 25,10" fill="var(--mascot-skin-light)" />
            <polygon points="25,10 32,3 32,24 25,31" fill="var(--mascot-skin-dark)" />
            <rect x="4" y="10" width="21" height="21" rx="4" fill="var(--mascot-skin)" />
            <polygon points="12,16 12,25 20,20.5" fill="var(--surface)" stroke="var(--ink)" stroke-width="1.5" />
          </g>
          <text
            x="38"
            y="26"
            font-family="'Space Grotesk Variable', 'Space Grotesk', sans-serif"
            font-size="22"
            font-weight="800"
            letter-spacing="-0.04em"
          >
            <tspan fill="var(--ink)">Dev</tspan>
            <tspan fill="var(--primary)">Play</tspan>
          </text>
          <rect x="127" y="21" width="6" height="6" rx="2" fill="var(--accent)" stroke="var(--ink)" stroke-width="1.5" />
        </svg>
      </a>

      <nav class="hidden md:flex items-center gap-5 font-display text-sm font-bold text-ink" aria-label="Main Navigation">
        <a href={docsHref} class="transition-colors hover:text-primary">
          {t('nav.docs')}
        </a>
        <a href={feedbackHref} class="transition-colors hover:text-primary">
          {t('nav.feedback')}
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        id="search-trigger"
        type="button"
        aria-label={t('nav.search')}
        class="inline-flex items-center gap-2 rounded-card border-2 border-ink bg-bg px-2 sm:px-3 py-1.5 text-xs font-semibold text-muted shadow-[2px_2px_0_0_var(--ink)] transition-all hover:-translate-x-px hover:-translate-y-px hover:shadow-[3px_3px_0_0_var(--ink)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0 text-ink"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline text-ink/80">{t('nav.search')}</span>
        <kbd class="hidden md:inline-flex items-center rounded border border-ink/40 bg-surface px-1.5 py-0.5 font-mono text-[10px] font-bold text-ink shadow-[1px_1px_0_0_var(--ink)]">
          Ctrl K
        </kbd>
      </button>

      <LanguageSwitcher lang={lang} />
      <ThemeToggle lang={lang} client:load />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function setupSearchTrigger() {
      var trigger = document.getElementById('search-trigger');
      if (trigger && !trigger.dataset.searchBound) {
        trigger.dataset.searchBound = 'true';
        trigger.addEventListener('click', function () {
          window.dispatchEvent(new CustomEvent('open-search-dialog'));
        });
      }
    }
    setupSearchTrigger();
    document.addEventListener('astro:page-load', setupSearchTrigger);
  })();
</script>
