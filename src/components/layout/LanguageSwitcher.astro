---
import { switchLangPath } from '@/i18n/utils';
import { useTranslations } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';

interface Props {
  lang: Lang;
  className?: string;
}

const { lang, className } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const idHref = switchLangPath(currentPath, 'id');
const enHref = switchLangPath(currentPath, 'en');
---

<nav aria-label={t('lang.switch')} class:list={['inline-flex items-center gap-1 rounded-card border-2 border-ink bg-surface p-0.5 shadow-hard', className]}>
  <a
    href={idHref}
    data-lang-target="id"
    data-astro-prefetch={lang !== 'id' ? 'load' : 'false'}
    aria-current={lang === 'id' ? 'page' : undefined}
    class:list={[
      'rounded-md px-2 py-0.5 font-mono text-xs transition-colors',
      lang === 'id'
        ? 'bg-accent text-neutral-950 font-extrabold shadow-[1px_1px_0_0_var(--ink)]'
        : 'text-muted font-bold hover:text-ink',
    ]}
  >
    ID
  </a>
  <span class="text-ink/30 font-mono text-[10px]" aria-hidden="true">|</span>
  <a
    href={enHref}
    data-lang-target="en"
    data-astro-prefetch={lang !== 'en' ? 'load' : 'false'}
    aria-current={lang === 'en' ? 'page' : undefined}
    class:list={[
      'rounded-md px-2 py-0.5 font-mono text-xs transition-colors',
      lang === 'en'
        ? 'bg-accent text-neutral-950 font-extrabold shadow-[1px_1px_0_0_var(--ink)]'
        : 'text-muted font-bold hover:text-ink',
    ]}
  >
    EN
  </a>
</nav>

<script is:inline>
  (function () {
    function restoreScrollPosition() {
      var savedScroll = sessionStorage.getItem('devplay-lang-switch-scroll');
      if (savedScroll !== null) {
        sessionStorage.removeItem('devplay-lang-switch-scroll');
        var ratio = parseFloat(savedScroll);
        if (!isNaN(ratio)) {
          requestAnimationFrame(function () {
            var newScrollMax = document.documentElement.scrollHeight - window.innerHeight;
            window.scrollTo({ top: ratio * newScrollMax, behavior: 'instant' });
          });
        }
      }
    }

    function setupLanguageSwitcher() {
      var langLinks = document.querySelectorAll('a[data-lang-target]');
      langLinks.forEach(function (link) {
        if (link.dataset.langBound) return;
        link.dataset.langBound = 'true';
        link.addEventListener('click', function () {
          var targetLang = link.getAttribute('data-lang-target');
          if (targetLang) {
            localStorage.setItem('devplay-lang', targetLang);
          }
          var scrollMax = document.documentElement.scrollHeight - window.innerHeight;
          var scrollRatio = scrollMax > 0 ? window.scrollY / scrollMax : 0;
          sessionStorage.setItem('devplay-lang-switch-scroll', String(scrollRatio));
        });
      });
      restoreScrollPosition();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLanguageSwitcher);
    } else {
      setupLanguageSwitcher();
    }
    document.addEventListener('astro:page-load', setupLanguageSwitcher);
  })();
</script>
