---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '@/i18n/config';
import { switchLangPath } from '@/i18n/utils';
import Header from '@/components/layout/Header.astro';
import { SearchDialog } from '@/components/search/SearchDialog';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description = 'DevPlay — Interactive Systems Concepts', lang } = Astro.props;
const currentPath = Astro.url.pathname;
const idHref = switchLangPath(currentPath, 'id');
const enHref = switchLangPath(currentPath, 'en');
const alternateHref = lang === 'id' ? enHref : idHref;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang="id" href={idHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="prefetch" href={alternateHref} as="document" />
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          var stored = localStorage.getItem('devplay-theme');
          var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);

        window.addEventListener('keydown', function (event) {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            window.dispatchEvent(new CustomEvent('devplay:open-search'));
          }
        });
      })();
    </script>
  </head>
  <body class="bg-bg text-ink min-h-screen font-sans antialiased">
    <Header lang={lang} />
    <slot />
    <SearchDialog lang={lang} client:idle />
  </body>
</html>
