---
import '@/styles/global.css';
import type { Lang } from '@/i18n/config';
import { switchLangPath } from '@/i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description = 'DevPlay — Interactive Systems Concepts', lang } = Astro.props;
const currentPath = Astro.url.pathname;
const idHref = switchLangPath(currentPath, 'id');
const enHref = switchLangPath(currentPath, 'en');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang="id" href={idHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('devplay-theme');
        var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="bg-bg text-ink min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>
