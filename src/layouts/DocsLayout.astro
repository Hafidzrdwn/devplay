---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import { SidebarDrawer } from '@/components/layout/SidebarDrawer';
import { Toc, type TocHeading } from '@/components/layout/Toc';
import PrevNext from '@/components/layout/PrevNext.astro';
import ConceptHeader from '@/components/mdx/ConceptHeader.astro';
import type { Lang } from '@/i18n/config';
import type { CategoryId, CrewId, Difficulty, VisualizationKind } from '@/types/content';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  tldr?: string;
  description?: string;
  lang: Lang;
  category: CategoryId;
  slug: string;
  headings?: MarkdownHeading[];
  difficulty?: Difficulty;
  readingMinutes?: number;
  speaker?: CrewId;
  visualization?: VisualizationKind;
  keywords?: string[];
}

const {
  title,
  tldr,
  description,
  lang,
  category,
  slug,
  headings = [],
  difficulty,
  readingMinutes,
  speaker,
  visualization,
  keywords = [],
} = Astro.props;

const tocHeadings: TocHeading[] = headings
  .filter((h): h is MarkdownHeading & { depth: 2 | 3 } => h.depth === 2 || h.depth === 3)
  .map((h) => ({
    depth: h.depth,
    slug: h.slug,
    text: h.text,
  }));
---

<BaseLayout title={`${title} | DevPlay`} description={tldr ?? description} lang={lang}>
  <div
    id="reading-progress-container"
    class="fixed top-0 left-0 right-0 z-50 h-0.75 bg-transparent pointer-events-none"
    aria-hidden="true"
  >
    <div
      id="reading-progress-bar"
      class="reading-progress-fill h-full bg-accent transition-[width] duration-75 ease-out w-0 shadow-[0_1px_1px_0_var(--ink)]"
    />
  </div>

  <div class="mx-auto max-w-7xl px-3 sm:px-6 py-6 sm:py-8">
    <div class="lg:hidden mb-6 flex items-center justify-between gap-4 border-b-2 border-ink pb-4">
      <SidebarDrawer lang={lang} client:media="(max-width: 1023px)">
        <div data-pagefind-ignore>
          <Sidebar lang={lang} currentCategory={category} currentSlug={slug} />
        </div>
      </SidebarDrawer>
      <span class="text-xs font-mono font-bold text-muted truncate">
        {title}
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] xl:grid-cols-[280px_minmax(0,1fr)_250px] gap-8 items-start">
      <aside class="hidden lg:block w-72 shrink-0 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto nb-scrollbar pr-2 pb-6" data-pagefind-ignore>
        <slot name="sidebar">
          <Sidebar lang={lang} currentCategory={category} currentSlug={slug} />
        </slot>
      </aside>

      <main class="w-full max-w-[75ch] mx-auto min-w-0" data-pagefind-body>
        <meta data-pagefind-filter="category[content]" content={category} />
        {difficulty && <meta data-pagefind-filter="difficulty[content]" content={difficulty} />}
        {visualization && <meta data-pagefind-filter="visualization[content]" content={visualization} />}
        {readingMinutes && difficulty ? (
          <div class="mb-8">
            <ConceptHeader
              lang={lang}
              title={title}
              category={category}
              difficulty={difficulty}
              readingMinutes={readingMinutes}
              tldr={tldr ?? description ?? ''}
              speaker={speaker ?? 'pixel'}
            />
          </div>
        ) : (
          <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-6 text-ink" data-pagefind-meta="title">
            {title}
          </h1>
        )}
        {keywords.length > 0 && (
          <span hidden data-pagefind-weight="8">{keywords.join(' ')}</span>
        )}
        <article class="prose-devplay max-w-[75ch] text-ink">
          <slot />
        </article>
        <slot name="footer">
          <PrevNext slug={slug} lang={lang} />
        </slot>
      </main>

      <aside class="hidden xl:block w-full sticky top-24 self-start pb-6" data-pagefind-ignore>
        <slot name="toc">
          <Toc headings={tocHeadings} lang={lang} client:idle />
        </slot>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      function setupReadingProgress() {
        if (window.CSS && CSS.supports && CSS.supports('animation-timeline', 'scroll()')) {
          return;
        }
        var bar = document.getElementById('reading-progress-bar');
        var article = document.querySelector('article.prose-devplay');
        if (!bar || !article) return;

        var ticking = false;

        function update() {
          var rect = article.getBoundingClientRect();
          var windowHeight = window.innerHeight;
          var totalDistance = rect.height - windowHeight;
          if (totalDistance <= 0) {
            bar.style.width = rect.top <= 0 ? '100%' : '0%';
          } else {
            var scrolled = -rect.top;
            var percent = Math.min(100, Math.max(0, (scrolled / totalDistance) * 100));
            bar.style.width = percent + '%';
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReadingProgress);
      } else {
        setupReadingProgress();
      }
      document.addEventListener('astro:page-load', setupReadingProgress);
    })();
  </script>
</BaseLayout>
