---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import { SidebarDrawer } from '@/components/layout/SidebarDrawer';
import { Toc, type TocHeading } from '@/components/layout/Toc';
import PrevNext from '@/components/layout/PrevNext.astro';
import type { Lang } from '@/i18n/config';
import type { CategoryId, Difficulty, VisualizationKind } from '@/types/content';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  category: CategoryId;
  slug: string;
  headings?: MarkdownHeading[];
  difficulty?: Difficulty;
  visualization?: VisualizationKind;
  keywords?: string[];
}

const {
  title,
  description,
  lang,
  category,
  slug,
  headings = [],
  difficulty,
  visualization,
  keywords = [],
} = Astro.props;

const tocHeadings: TocHeading[] = headings
  .filter((h): h is MarkdownHeading & { depth: 2 | 3 } => h.depth === 2 || h.depth === 3)
  .map((h) => ({
    depth: h.depth,
    slug: h.slug,
    text: h.text,
  }));
---

<BaseLayout title={`${title} | DevPlay`} description={description} lang={lang}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 sm:py-8">
    <div class="lg:hidden mb-6 flex items-center justify-between gap-4 border-b-2 border-ink pb-4">
      <SidebarDrawer lang={lang} client:media="(max-width: 1023px)">
        <div data-pagefind-ignore>
          <Sidebar lang={lang} currentCategory={category} currentSlug={slug} />
        </div>
      </SidebarDrawer>
      <span class="text-xs font-mono font-bold text-muted truncate">
        {title}
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)_240px] gap-8 items-start">
      <aside class="hidden lg:block w-[280px] shrink-0" data-pagefind-ignore>
        <slot name="sidebar">
          <Sidebar lang={lang} currentCategory={category} currentSlug={slug} />
        </slot>
      </aside>

      <main class="w-full max-w-[75ch] mx-auto min-w-0" data-pagefind-body>
        <meta data-pagefind-filter="category[content]" content={category} />
        {difficulty && <meta data-pagefind-filter="difficulty[content]" content={difficulty} />}
        {visualization && <meta data-pagefind-filter="visualization[content]" content={visualization} />}
        <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-6 text-ink" data-pagefind-meta="title">
          {title}
        </h1>
        {keywords.length > 0 && (
          <span hidden data-pagefind-weight="8">{keywords.join(' ')}</span>
        )}
        <article class="prose max-w-none text-ink">
          <slot />
        </article>
        <slot name="footer">
          <PrevNext slug={slug} lang={lang} />
        </slot>
      </main>

      <aside class="hidden xl:block w-[240px] shrink-0" data-pagefind-ignore>
        <slot name="toc">
          <Toc headings={tocHeadings} lang={lang} client:idle />
        </slot>
      </aside>
    </div>
  </div>
</BaseLayout>
