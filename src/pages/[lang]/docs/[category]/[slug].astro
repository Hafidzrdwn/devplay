---
import { getCollection, render } from 'astro:content';
import { getConcept } from '@/data/concepts';
import DocsLayout from '@/layouts/DocsLayout.astro';
import type { Lang } from '@/i18n/config';
import type { CategoryId } from '@/types/content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  return docs.flatMap((entry) => {
    const normalizedId = entry.id.replace(/\\/g, '/');
    const parts = normalizedId.split('/');
    const langPart = parts[0];
    const categoryPart = parts[1];
    const filePart = parts[2];

    if (!langPart || !categoryPart || !filePart) {
      return [];
    }

    if (langPart !== 'id' && langPart !== 'en') {
      return [];
    }

    const lang = langPart as Lang;
    const category = categoryPart as CategoryId;
    const slug = filePart.replace(/\.mdx$/, '');

    const concept = getConcept(slug);
    if (!concept || concept.category !== category) {
      return [];
    }

    return [
      {
        params: { lang, category, slug },
        props: { entry },
      },
    ];
  });
}

const { entry } = Astro.props;
const { lang, category, slug } = Astro.params as {
  lang: Lang;
  category: CategoryId;
  slug: string;
};

const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.tldr}
  lang={lang}
  category={category}
  slug={slug}
  headings={headings}
>
  <Content />
</DocsLayout>
