---
export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevPlay - {lang}</title>
  </head>
  <body>
    <main>
      <h1>DevPlay</h1>
      <p>{lang}</p>
    </main>
  </body>
</html>
