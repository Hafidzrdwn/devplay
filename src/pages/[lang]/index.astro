---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout title={`DevPlay - ${lang.toUpperCase()}`} lang={lang}>
  <main class="max-w-xl mx-auto p-8 space-y-6">
    <div class="nb-card p-6">
      <h1 class="font-heading text-3xl font-bold mb-2">DevPlay</h1>
      <p class="text-muted mb-4">{lang}</p>
      <span class="nb-badge">{t('nav.docs')}</span>
    </div>
  </main>
</BaseLayout>
