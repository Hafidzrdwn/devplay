---
import '../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevPlay - {lang}</title>
  </head>
  <body class="bg-bg text-ink min-h-screen p-8 font-sans">
    <main class="max-w-xl mx-auto space-y-6">
      <div class="nb-card p-6">
        <h1 class="font-heading text-3xl font-bold mb-2">DevPlay</h1>
        <p class="text-muted">{lang}</p>
      </div>
    </main>
  </body>
</html>
